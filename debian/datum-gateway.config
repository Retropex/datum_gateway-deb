#!/bin/sh
# Exit immediately if a command produces an error.
set -e
# Source debconf library
. /usr/share/debconf/confmodule

db_input critical datum-gateway/bitcoin-address || [ $? -eq 30 ]
db_go || true

db_input high datum-gateway/log || [ $? -eq 30 ]
db_go || true

db_input high datum-gateway/blocknotify || [ $? -eq 30 ]
db_go || true

db_input medium datum-gateway/coinbase-tag-secondary || [ $? -eq 30 ]
db_go || true

db_input low datum-gateway/work_update_seconds || [ $? -eq 30 ]
db_go || true
db_get datum-gateway/work_update_seconds || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -ge 5 ] && [ "$RET" -le 120 ] ; }; then
		break
	fi
	db_input low datum-gateway/work_update_seconds || true
	db_go || true
	db_get datum-gateway/work_update_seconds || RET=
	done
fi
unset RET


db_input low datum-gateway/listen_port || [ $? -eq 30 ]
db_go || true
db_get datum-gateway/listen_port || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -ge 1 ] && [ "$RET" -le 65535 ] ; }; then
		break
	fi
	db_input low datum-gateway/listen_port || true
	db_go || true
	db_get datum-gateway/listen_port || RET=
	done
fi
unset RET

db_input low datum-gateway/max_clients_per_thread || [ $? -eq 30 ]
db_go || true
db_get datum-gateway/max_clients_per_thread || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -gt 0 ]; then
		break
	fi
	db_input low datum-gateway/max_clients_per_thread || true
	db_go || true
	db_get datum-gateway/max_clients_per_thread || RET=
	done
fi
unset RET

db_input low datum-gateway/max_threads || [ $? -eq 30 ]
db_go || true
db_get datum-gateway/max_threads || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -ge 1 ] && [ "$RET" -le 64 ] ; }; then
		break
	fi
	db_input low datum-gateway/max_threads || true
	db_go || true
	db_get datum-gateway/max_threads || RET=
	done
fi
unset RET

db_input low datum-gateway/max_clients || [ $? -eq 30 ]
db_go || true
db_get datum-gateway/max_clients || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -gt 0 ]; then
		break
	fi
	db_input low datum-gateway/max_clients || true
	db_go || true
	db_get datum-gateway/max_clients || RET=
	done
fi
unset RET

db_input low datum-gateway/vardiff_min || [ $? -eq 30 ]
db_go || true
db_get datum-gateway/vardiff_min || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -gt 0 ]; then
		break
	fi
	db_input low datum-gateway/vardiff_min || true
	db_go || true
	db_get datum-gateway/vardiff_min || RET=
	done
fi
unset RET

db_input low datum-gateway/coinbase_tag_primary || [ $? -eq 30 ]
db_go || true

db_input low datum-gateway/modify_conf || [ $? -eq 30 ]
db_go || true

db_input low datum-gateway/log_level_file || [ $? -eq 30 ]
db_go || true
db_get datum-gateway/log_level_file || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -ge 0 ] && [ "$RET" -le 5 ] ; }; then
		break
	fi
	db_input low datum-gateway/log_level_file || true
	db_go || true
	db_get datum-gateway/log_level_file || RET=
	done
fi
unset RET

db_input low datum-gateway/pool_pass_workers || [ $? -eq 30 ]
db_go || true

db_input low datum-gateway/pool_pass_full_users || [ $? -eq 30 ]
db_go || true

db_input low datum-gateway/pooled_mining_only || [ $? -eq 30 ]
db_go || true