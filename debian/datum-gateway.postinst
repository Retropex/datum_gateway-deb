#!/bin/bash

set -e

USER="bitcoin"

# Source debconf library
. /usr/share/debconf/confmodule

update_conf_param () {
  local param="$1"
  local json="$2"
  db_get "datum-gateway/$param" || RET=
  if [ "$RET" ]; then
    runuser -u $USER -- jq --argjson PARAM "$RET" --arg JSON "$json" 'setpath($JSON | split("."); $PARAM)' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
        && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
  fi
  unset RET
}

case "$1" in
  configure)
  
  if [ -z "$2" ]; then
    mkdir -p /etc/datum-gateway
    if [ ! -f /etc/datum-gateway/datum_gateway_config.json ]; then
      cp /usr/share/datum-gateway/datum_gateway_config.json /etc/datum-gateway/datum_gateway_config.json
    fi
    PASSWORD=$(pwgen -s 32 1)
    db_set datum-gateway/password "$PASSWORD"
    chown $USER:$USER /etc/datum-gateway/datum_gateway_config.json
    runuser -u $USER -- jq --arg PASSWORD "$PASSWORD" 'del(.bitcoind.rpcuser) | del(.bitcoind.rpcpassword) | .bitcoind.rpccookiefile = "/var/lib/bitcoin/.cookie" | .mining.pool_address = "" | .api.admin_password = $PASSWORD | .api.modify_conf = true' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
      && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
    db_subst datum-gateway/password PASSWORD "$PASSWORD"
    db_fset datum-gateway/password seen false
    db_input high datum-gateway/password || true
    db_go
  fi
  
  if [ -f /etc/datum-gateway/datum_gateway_config.json ]; then
    db_get datum-gateway/bitcoin-address || RET=
    if [ "$RET" ]; then
      runuser -u $USER -- jq --arg BTCADDRESS "$RET" '.mining.pool_address = $BTCADDRESS' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
        && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
    else
      db_input critical datum-gateway/bitcoin-address-blank || true
      db_go || true
    fi
    unset RET
    
    db_get datum-gateway/coinbase-tag-secondary || RET=
    if [ "$RET" ]; then
      runuser -u $USER -- jq --arg TAG "$RET" '.mining.coinbase_tag_secondary = $TAG' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
        && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
    else
      runuser -u $USER -- jq '.mining.coinbase_tag_secondary = "DATUM User"' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
        && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
    fi
    unset RET
    
    db_get datum-gateway/coinbase_tag_primary || RET=
    if [ "$RET" ]; then
      runuser -u $USER -- jq --arg TAG "$RET" '.mining.coinbase_tag_primary = $TAG' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
        && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
    else
      runuser -u $USER -- jq '.mining.coinbase_tag_primary = "DATUM Gateway"' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
        && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
    fi
    unset RET
    
    update_conf_param work_update_seconds bitcoind.work_update_seconds
    update_conf_param listen_port stratum.listen_port
    update_conf_param max_clients_per_thread stratum.max_clients_per_thread
    update_conf_param max_threads stratum.max_threads
    update_conf_param max_clients stratum.max_clients
    update_conf_param vardiff_min stratum.vardiff_min
    update_conf_param modify_conf api.modify_conf
    update_conf_param log_level_file logger.log_level_file
    update_conf_param pool_pass_workers datum.pool_pass_workers
    update_conf_param pool_pass_full_users datum.pool_pass_full_users
    update_conf_param pooled_mining_only datum.pooled_mining_only
  fi

  if [ -d /var/log/datum-gateway ]; then
    if ! dpkg-statoverride --list /var/log/datum-gateway >/dev/null 2>&1; then
      dpkg-statoverride --update --add bitcoin adm 0755 /var/log/datum-gateway
    fi
    
    db_get datum-gateway/log || RET=
    if [ "$RET" = "true" ]; then
      runuser -u $USER -- jq '.logger.log_to_file = true' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
        && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
      runuser -u $USER -- jq '.logger.log_file = "/var/log/datum-gateway/datum.log"' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
        && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
    elif [ "$RET" = "false" ]; then
      runuser -u $USER -- jq '.logger.log_to_file = false' /etc/datum-gateway/datum_gateway_config.json > /etc/datum-gateway/datum_gateway_config.json.tmp \
        && mv /etc/datum-gateway/datum_gateway_config.json.tmp /etc/datum-gateway/datum_gateway_config.json
    fi
    unset RET
  fi

  if [ -f /etc/bitcoin/bitcoin.conf ]; then
    db_get datum-gateway/blocknotify || RET=
    if [ "$RET" = "true" ]; then
      if grep -s -q -E '^#?blocknotify=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?blocknotify=/c\blocknotify=killall -USR1 datum_gateway" /etc/bitcoin/bitcoin.conf
        invoke-rc.d bitcoin-knots restart || true
      else
        db_input high datum-gateway/blocknotify-fail || true
        db_go || true
      fi
    elif [ "$RET" = "false" ]; then
      if grep -s -q -E '^#?blocknotify=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?blocknotify=/c\#blocknotify=<cmd>" /etc/bitcoin/bitcoin.conf
        invoke-rc.d bitcoin-knots restart || true
      else
        db_input high datum-gateway/blocknotify-fail || true
        db_go || true
      fi
    fi
    unset RET
  fi

  db_stop
  ;;
esac


#DEBHELPER#

exit 0
