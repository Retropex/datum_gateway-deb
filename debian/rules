#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
	-DCMAKE_INSTALL_DOCDIR=share/doc/datum-gateway

execute_after_dh_auto_install:
	# Install the example config as a template.
	mkdir -p debian/datum-gateway/usr/share/datum-gateway
	cp doc/example_datum_gateway_config.json debian/datum-gateway/usr/share/datum-gateway/datum_gateway_config.json

execute_after_dh_installdocs:
	mv debian/datum-gateway/usr/share/doc/datum-gateway/doc/DATUM_recommended_setup-network_diagram.svg debian/datum-gateway/usr/share/doc/datum-gateway/
	mv debian/datum-gateway/usr/share/doc/datum-gateway/doc/usernames.md debian/datum-gateway/usr/share/doc/datum-gateway/
	rmdir debian/datum-gateway/usr/share/doc/datum-gateway/doc
	rm -f debian/datum-gateway/usr/share/doc/datum-gateway/example_datum_gateway_config.json

